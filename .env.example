# ---------------------------------------------------------------------------
# AssessDev frontend environment variables
# Copy to .env.local for local development, or add the same keys in
# Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time. After changing them,
# redeploy the project (Vercel -> Deployments -> Redeploy) for them to apply.
# ---------------------------------------------------------------------------

# Backend REST API base (must include /api/v1).
# Public deployed backend:
NEXT_PUBLIC_API_URL=https://developerassessmentbackend.vercel.app/api/v1
# Local backend alternative:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Canonical frontend origin (no trailing slash). Used for metadata, robots.txt
# and sitemap.xml. On Vercel this is auto-detected when omitted, but setting it
# to your production domain is recommended.
# NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# Google Identity Services client ID. When set, the "Continue with Google"
# button appears on /login. Must be the SAME client ID configured on the
# backend (GOOGLE_CLIENT_ID) and must list this frontend origin under
# "Authorized JavaScript origins" in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
